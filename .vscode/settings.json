{
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/host-debug/compile_commands.json",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src/lib/include",
    "${workspaceFolder}/src/lib/runtime/include",
    "${workspaceFolder}/src/boards/rpi/common",
    "${workspaceFolder}/src/boards/esp32/common",
    "${workspaceFolder}/src/boards/esp32/waveshare-esp32-c6-zero",
    "${workspaceFolder}/src/boards/esp32/waveshare-esp32-s3-zero"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=build/host-debug"
  ],
  "clangd.fallbackFlags": [
    "-xc",
    "-std=c11",
    "-Isrc/lib/include",
    "-Isrc/lib/runtime/include",
    "-Isrc/boards/rpi/common",
    "-Isrc/boards/esp32/common",
    "-Isrc/boards/esp32/waveshare-esp32-c6-zero",
    "-Isrc/boards/esp32/waveshare-esp32-s3-zero"
  ],
  "editor.semanticHighlighting.enabled": true,
  "cmake.configureOnOpen": true,
  "cmake.useCMakePresets": "always",
  "files.associations": {
    "*.h": "c"
  }
}
