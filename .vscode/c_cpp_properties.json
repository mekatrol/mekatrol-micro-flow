{
  "version": 4,
  "configurations": [
    {
      "name": "Micro Flow Host",
      "cStandard": "c11",
      "compileCommands": "${workspaceFolder}/build/host-debug/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/src/lib/include",
        "${workspaceFolder}/src/lib/runtime/include",
        "${workspaceFolder}/src/boards/rpi/common",
        "${workspaceFolder}/src/boards/esp32/common",
        "${workspaceFolder}/src/boards/esp32/waveshare-esp32-c6-zero",
        "${workspaceFolder}/src/boards/esp32/waveshare-esp32-s3-zero"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/src/lib/include",
          "${workspaceFolder}/src/lib/runtime/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
