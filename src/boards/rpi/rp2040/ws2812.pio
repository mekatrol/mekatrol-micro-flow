.program ws2812
.side_set 1

; WS2812 timing at 800 kHz.
;
; Each bit takes 10 PIO cycles.
; T1 = 2, T2 = 5, T3 = 3.
;
; Logical 0:
;   High for 2 cycles, low for 8 cycles.
;
; Logical 1:
;   High for 7 cycles, low for 3 cycles.
;
; The state machine is configured for 8 MHz, giving:
;   Logical 0 high = 250 ns
;   Logical 1 high = 875 ns
;   Total bit time = 1.25 us

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x, do_zero side 1 [T1 - 1]
do_one:
    jmp bitloop    side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap