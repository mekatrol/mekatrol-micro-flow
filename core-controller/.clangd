Diagnostics:
  # Public umbrella headers are intentional in this project.
  UnusedIncludes: None

CompileFlags:
  # Portable libraries and host tests use the host configuration.
  CompilationDatabase: build/host-debug
  Add:
    - -Wno-empty-translation-unit
    - -I../../src/lib/include
    - -I../../src/lib/runtime/include

---
If:
  PathMatch: src/boards/rpi/.*
CompileFlags:
  # The build scripts select the active embedded configuration.
  CompilationDatabase: build/clangd
  Remove:
    - -Werror
    - -fsanitize=*
    - -fno-omit-frame-pointer