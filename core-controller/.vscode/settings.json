{
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--query-driver=**/arm-none-eabi-gcc,**/riscv32-unknown-elf-gcc"
  ],
  "clangd.fallbackFlags": [
    "-xc",
    "-std=c11",
    "-I${workspaceFolder}/src/lib/include",
    "-I${workspaceFolder}/src/lib/runtime/include",
    "-I${workspaceFolder}/src/boards/rpi/raspberry-pi-pico",
    "-I${workspaceFolder}/src/boards/rpi/raspberry-pi-pico-2",
    "-I${workspaceFolder}/src/boards/rpi/rp2040",
    "-I${workspaceFolder}/src/boards/rpi/rp2350"
  ],
  "editor.semanticHighlighting.enabled": true,
  "cmake.configureOnOpen": true,
  "cmake.useCMakePresets": "always",
  "files.associations": {
    "*.h": "c"
  }
}
