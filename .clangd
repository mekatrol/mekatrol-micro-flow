Diagnostics:
  # Public umbrella headers are intentional in this project.
  UnusedIncludes: None

CompileFlags:
  # CMake exports commands from this directory for the default host preset.
  CompilationDatabase: build/host-debug
  Add:
    - -Wno-empty-translation-unit
    # Fallback includes for headers and firmware sources absent from the host
    # database. These paths are relative to its working directory.
    - -I../../src/lib/include
    - -I../../src/lib/runtime/include
    - -I../../src/boards/rpi/raspberry-pi-pico
    - -I../../src/boards/rpi/raspberry-pi-pico-2
    - -I../../src/boards/rpi/rp2040
    - -I../../src/boards/rpi/rp2350

---
If:
  PathMatch: src/boards/rpi/(raspberry-pi-pico|rp2040)/.*
CompileFlags:
  # RP2040 firmware needs Pico SDK and TinyUSB compile definitions/includes.
  CompilationDatabase: build/pico-debug
  Remove:
    - -Werror
    - -fsanitize=*
    - -fno-omit-frame-pointer

---
If:
  PathMatch: src/boards/rpi/(raspberry-pi-pico-2|rp2350)/.*
CompileFlags:
  # Pico 2 sources use the Arm preset by default; the RISC-V preset remains
  # available when checking that architecture explicitly.
  CompilationDatabase: build/pico2-arm-debug
  Remove:
    - -Werror
    - -fsanitize=*
    - -fno-omit-frame-pointer
