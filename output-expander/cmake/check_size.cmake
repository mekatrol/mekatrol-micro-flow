execute_process(COMMAND "${SIZE_TOOL}" -B "${ELF}" OUTPUT_VARIABLE report RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not inspect ${ELF}")
endif()
string(REGEX MATCH "\n[ \t]*([0-9]+)[ \t]+([0-9]+)[ \t]+([0-9]+)" _totals "${report}")
set(text_size "${CMAKE_MATCH_1}")
set(data_size "${CMAKE_MATCH_2}")
set(bss_size "${CMAKE_MATCH_3}")
if(text_size STREQUAL "")
  set(text_size 0)
endif()
if(data_size STREQUAL "")
  set(data_size 0)
endif()
if(bss_size STREQUAL "")
  set(bss_size 0)
endif()
math(EXPR flash_used "${text_size} + ${data_size}")
math(EXPR ram_used "${data_size} + ${bss_size}")
message(STATUS "CH32V003 budget: Flash ${flash_used}/16384 bytes; static SRAM ${ram_used}/2048 bytes")
if(flash_used GREATER 16384 OR ram_used GREATER 2048)
  message(FATAL_ERROR "CH32V003 image exceeds device memory")
endif()
