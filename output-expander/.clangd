
Diagnostics:
  UnusedIncludes: None

CompileFlags:
  # Default for portable sources and unit tests.
  CompilationDatabase: build/host-debug
  Add:
    - -Isrc

---
If:
  PathMatch: src/(main|hal|rs485|ch32v003)\.(c|h)|src/startup\.S

CompileFlags:
  # Hardware sources use the cross-compilation database.
  CompilationDatabase: build/ch32v003-release

  Remove:
    - -Werror
    - -march=*
    - -mabi=*

  Add:
    - --target=riscv32-unknown-elf
