{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MICROFLOW_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "host-debug",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROFLOW_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MICROFLOW_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "pico-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MICROFLOW_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "pico-debug",
      "inherits": "pico-base",
      "cacheVariables": { "MICROFLOW_BOARD": "raspberry-pi-pico" }
    },
    {
      "name": "waveshare-rp2040-zero-debug",
      "inherits": "pico-base",
      "cacheVariables": {
        "MICROFLOW_BOARD": "raspberry-pi-pico",
        "MICROFLOW_WAVESHARE_RP2040_ZERO": "ON"
      }
    },
    {
      "name": "pico2-arm-debug",
      "inherits": "pico-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
      "cacheVariables": { "MICROFLOW_BOARD": "raspberry-pi-pico-2-arm" }
    },
    {
      "name": "pico2-riscv-debug",
      "inherits": "pico-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/riscv32-unknown-elf-gcc.cmake",
      "cacheVariables": { "MICROFLOW_BOARD": "raspberry-pi-pico-2-riscv" }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "pico-debug", "configurePreset": "pico-debug" },
    { "name": "waveshare-rp2040-zero-debug", "configurePreset": "waveshare-rp2040-zero-debug" },
    { "name": "pico2-arm-debug", "configurePreset": "pico2-arm-debug" },
    { "name": "pico2-riscv-debug", "configurePreset": "pico2-riscv-debug" }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
