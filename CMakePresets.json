{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MICROFLOW_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "host-debug",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROFLOW_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MICROFLOW_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "waveshare-rp2040-zero-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROFLOW_BOARD": "waveshare-rp2040-zero",
        "MICROFLOW_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "raspberry-pi-pico-2-arm-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROFLOW_BOARD": "raspberry-pi-pico-2-arm",
        "MICROFLOW_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "raspberry-pi-pico-2-riscv-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/riscv32-unknown-elf-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROFLOW_BOARD": "raspberry-pi-pico-2-riscv",
        "MICROFLOW_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "waveshare-esp32-c6-zero-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/riscv32-esp-elf-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROFLOW_BOARD": "waveshare-esp32-c6-zero",
        "MICROFLOW_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "waveshare-esp32-s3-zero-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/xtensa-esp32s3-elf-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROFLOW_BOARD": "waveshare-esp32-s3-zero",
        "MICROFLOW_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "waveshare-rp2040-zero-debug",
      "configurePreset": "waveshare-rp2040-zero-debug"
    },
    {
      "name": "raspberry-pi-pico-2-arm-debug",
      "configurePreset": "raspberry-pi-pico-2-arm-debug"
    },
    {
      "name": "raspberry-pi-pico-2-riscv-debug",
      "configurePreset": "raspberry-pi-pico-2-riscv-debug"
    },
    {
      "name": "waveshare-esp32-c6-zero-debug",
      "configurePreset": "waveshare-esp32-c6-zero-debug"
    },
    {
      "name": "waveshare-esp32-s3-zero-debug",
      "configurePreset": "waveshare-esp32-s3-zero-debug"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
