set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

find_program(CMAKE_C_COMPILER riscv32-esp-elf-gcc REQUIRED)
find_program(CMAKE_ASM_COMPILER riscv32-esp-elf-gcc REQUIRED)
find_program(CMAKE_OBJCOPY riscv32-esp-elf-objcopy REQUIRED)
find_program(CMAKE_SIZE riscv32-esp-elf-size REQUIRED)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
